  "corrupted_memory_state": {
    "_comment": "isNew() only rules out NULL stability/difficulty; a persisted value that is present but out of range (e.g. exactly 0) is a separate case. Both were found to diverge between the PHP scheduler and its JS mirror -- PHP produced NaN via pow(0, negative), JS silently substituted an ease-factor-scale constant for a stability value -- and are pinned here so neither regresses. state=review, elapsedDays=10 (from 2026-01-01T10:00:00Z to 2026-01-11T10:00:00Z), rating=Good, fuzzing off, rolloverHour=4, timezone=UTC.",
    "cases": [
      {
        "description": "stability present but exactly 0 -- must floor to S_MIN rather than produce NaN",
        "stability": 0.0,
        "difficulty": 5.0,
        "expected_stability": 0.1030719202221,
        "expected_difficulty": 4.9902
      },
      {
        "description": "difficulty missing while stability is set -- must be treated as a brand new card, not an established one with a masked default difficulty",
        "stability": 10.0,
        "difficulty": null,
        "expected_stability": 2.3065,
        "expected_difficulty": 2.1181
      }
    ]
  },
  "day_difference": {
